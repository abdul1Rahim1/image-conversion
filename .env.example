# ─── Image generation provider ─────────────────────────────
# One of: openai | replicate
IMAGE_PROVIDER=openai

# OpenAI (gpt-image-1 via images.edit)
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high

# Replicate (Flux Kontext — image-to-image edit)
REPLICATE_API_TOKEN=r8_...
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

# ─── Copy rewriting (title / description) ──────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7
REWRITE_COPY=true

# ─── Storage (S3-compatible: Cloudflare R2, AWS S3, etc.) ──
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_BUCKET=product-images
S3_REGION=auto
# Public base URL that fronts the bucket (e.g. R2 custom domain)
PUBLIC_BASE_URL=https://cdn.example.com

# ─── Pipeline behavior ─────────────────────────────────────
VARIATIONS_PER_IMAGE=3
CONCURRENCY=4
OUTPUT_FORMAT=webp
OUTPUT_QUALITY=85
# CSV column names in your input file
COL_ID=id
COL_TITLE=title
COL_DESCRIPTION=description
COL_IMAGE_URL=image_url
