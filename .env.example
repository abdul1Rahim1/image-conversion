IMAGE_PROVIDER=openai

OPENAI_API_KEY=your openai api key
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high

REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

ANTHROPIC_API_KEY=your anthropi api key
REWRITE_COPY=true

S3_ENDPOINT_URL=your s3 endpoint url
S3_ACCESS_KEY_ID=your s3 access key id
S3_SECRET_ACCESS_KEY=your s3 secret access key
S3_BUCKET=product-images
S3_REGION=auto
PUBLIC_BASE_URL=your public base url

# ─── Pipeline behavior ─────────────────────────────────────
# N=1 (default): one front-facing clean-background image per product, output
# under the single `image_url` column. N>1: extra angles/lighting, output
# under `variant_1_url`, `variant_2_url`, ...
VARIATIONS_PER_IMAGE=1
>>>>>>> claude/product-image-variations-jn9nmc
CONCURRENCY=4
OUTPUT_FORMAT=webp
OUTPUT_QUALITY=85

COL_ID=ASIN
COL_TITLE=Title
COL_DESCRIPTION=Category
COL_IMAGE_URL=Image URL

# ─── FastAPI service ──────────────────────────────────────
# Shared secret the WordPress plugin sends as X-API-Key. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=change-me-to-a-long-random-string
# Path to the Amazon-shape JSON the service will search.
CATALOG_PATH=catalog.json
# Where the SQLite materialized-product cache lives.
CACHE_DB_PATH=cache.sqlite
# Comma-separated origins allowed to call the API from a browser (leave *
# only in dev; in prod set to https://yourstore.com).
ALLOWED_ORIGINS=*
