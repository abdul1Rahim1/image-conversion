# ─── Image generation provider ─────────────────────────────
# One of: openai | replicate
IMAGE_PROVIDER=openai

# OpenAI (gpt-image-1 via images.edit)
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high

# Replicate (Flux Kontext — image-to-image edit)
REPLICATE_API_TOKEN=r8_...
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

# ─── Copy rewriting (title / description) ──────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7
REWRITE_COPY=true

# ─── Storage (S3-compatible: Cloudflare R2, AWS S3, etc.) ──
# IMPORTANT for R2: endpoint URL must NOT include the bucket name.
# Correct:  https://<accountid>.r2.cloudflarestorage.com
# Wrong:    https://<accountid>.r2.cloudflarestorage.com/product-images
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_BUCKET=product-images
S3_REGION=auto
# Public base URL that fronts the bucket. For R2, the r2.dev URL works:
# https://pub-<hash>.r2.dev
PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# ─── Pipeline behavior ─────────────────────────────────────
# N=1 (default): one front-facing clean-background image per product, output
# under the single `image_url` column. N>1: extra angles/lighting, output
# under `variant_1_url`, `variant_2_url`, ...
VARIATIONS_PER_IMAGE=1
CONCURRENCY=4
OUTPUT_FORMAT=webp
OUTPUT_QUALITY=85

# ─── Column mapping ────────────────────────────────────────
# Set these to your JSON/CSV field names. For the Amazon scrape sample:
#   COL_ID=ASIN
#   COL_TITLE=Title
#   COL_DESCRIPTION=Category
#   COL_IMAGE_URL=Image URL
# (Amazon data has no description, so we point description at Category as a
# stand-in. If your data has a real description field, use that.)
COL_ID=ASIN
COL_TITLE=Title
COL_DESCRIPTION=Category
COL_IMAGE_URL=Image URL
